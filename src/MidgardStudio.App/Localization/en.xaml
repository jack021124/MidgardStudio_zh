    <!-- ===== Navigation sections (ShellViewModel) ===== -->
    <s:String x:Key="Nav_Items">Items</s:String>
    <s:String x:Key="Nav_Items_Desc">Server item database (item_db): stats, bonuses, restrictions and drop sources.</s:String>
    <s:String x:Key="Nav_ClientItems">Client Items</s:String>
    <s:String x:Key="Nav_ClientItems_Desc">Client item info (itemInfo.lua / itemInfo_C.lua): names, descriptions, slots, view and sprite.</s:String>
    <s:String x:Key="Nav_Mobs">Mobs</s:String>
    <s:String x:Key="Nav_Mobs_Desc">Monster database (mob_db) with drops, modes and client sprite registration.</s:String>
    <s:String x:Key="Nav_MobAvail">Mob Sprite Reuse</s:String>
    <s:String x:Key="Nav_MobAvail_Desc">Reuse another mob's (or a job) sprite for a mob (mob_avail).</s:String>
    <s:String x:Key="Nav_Pets">Pets</s:String>
    <s:String x:Key="Nav_Pets_Desc">Pet database (pet_db): taming, intimacy, evolution and bonus scripts.</s:String>
    <s:String x:Key="Nav_Combos">Item Combos</s:String>
    <s:String x:Key="Nav_Combos_Desc">Item set combos (item_combos) and their bonus scripts.</s:String>
    <s:String x:Key="Nav_Groups">Item Groups</s:String>
    <s:String x:Key="Nav_Groups_Desc">Item group pools (item_group_db) with sub-groups and rates.</s:String>
    <s:String x:Key="Nav_Skills">Skills</s:String>
    <s:String x:Key="Nav_Skills_Desc">Skill database (skill_db).</s:String>
    <s:String x:Key="Nav_ClientSkills">Client Skills</s:String>
    <s:String x:Key="Nav_ClientSkills_Desc">Client skill info (skillinfoz): names, max level, SP cost, range, prerequisites, descriptions and cast/delay timings.</s:String>
    <s:String x:Key="Nav_Achievements">Achievements</s:String>
    <s:String x:Key="Nav_Achievements_Desc">Achievement database (achievement_db): targets, dependencies and rewards.</s:String>
    <s:String x:Key="Nav_Abra">Class Change</s:String>
    <s:String x:Key="Nav_Abra_Desc">Abracadabra / Hocus-Pocus random skill table (abra_db).</s:String>
    <s:String x:Key="Nav_Summon">Summon Groups</s:String>
    <s:String x:Key="Nav_Summon_Desc">Summon group pools (mob_summon): Bloody Branch, Dead Branch, Class Change, Poring Box, …</s:String>
    <s:String x:Key="Nav_Grf">GRF Browser</s:String>
    <s:String x:Key="Nav_Grf_Desc">Browse client GRF archives: preview icons/sprites and read lua files.</s:String>
    <s:String x:Key="Nav_CashShop">Cash Shop</s:String>
    <s:String x:Key="Nav_CashShop_Desc">Cash shop (item_cash_db): items and their cash-point prices, per tab.</s:String>
