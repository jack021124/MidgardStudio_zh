<ui:FluentWindow x:Class="MidgardStudio.App.Views.AboutDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource About_Title}"
                 Icon="/Assets/logo.png"
                 Width="480" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource About_TitleBar}" />

        <StackPanel Grid.Row="1" Margin="24,8,24,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo.png" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App_Title}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource App_Subtitle}" Opacity="0.7" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="VersionText" Opacity="0.55" FontSize="12" Margin="0,14,0,0" />

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20" Opacity="0.85"
                       Text="{DynamicResource About_Description}" />

            <Border Margin="0,16,0,0" CornerRadius="6" Background="#1A4A8F3C" BorderBrush="#3A6FD08A"
                    BorderThickness="1" Padding="12,10">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                           Text="{DynamicResource About_SafetyNote}" />
            </Border>

            <TextBlock Margin="0,18,0,0" FontSize="13">
                <Run Text="{DynamicResource About_CreatedBy}" /><Run Text="Kyoshio" FontWeight="SemiBold" />
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button x:Name="OkButton" Content="{DynamicResource About_Close}" Appearance="Primary" MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
