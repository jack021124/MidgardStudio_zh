<UserControl x:Class="MidgardStudio.App.Views.ClientItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MidgardStudio.App.ViewModels"
             xmlns:common="clr-namespace:MidgardStudio.App.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ClientItemsViewModel}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
            <TextBlock Text="{DynamicResource ClientItems_Loading}" Opacity="0.7" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Master list -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                        <ui:Button Command="{Binding AddCustomCommand}" Margin="0,0,4,0" ToolTip="{DynamicResource ClientItems_AddTip}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding DuplicateCommand}" Margin="0,0,4,0" ToolTip="{DynamicResource ClientItems_DupTip}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding CopyEntryCommand}" Margin="0,0,4,0" ToolTip="{DynamicResource ClientItems_CopyTip}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ClipboardLink24" /></ui:Button.Icon>
                        </ui:Button>
                        <ToggleButton IsChecked="{Binding List.OverriddenOnly, Mode=TwoWay}"
                                      ToolTip="{DynamicResource ClientItems_FilterTip}">
                            <ui:SymbolIcon Symbol="Filter24" />
                        </ToggleButton>
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Tag="ListSearch" PlaceholderText="{DynamicResource ClientItems_SearchPH}"
                                Text="{Binding List.SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding List.StatusText}" Opacity="0.6"
                           Margin="2,6,0,0" FontSize="11" />
                <ListView x:Name="MasterList" ItemsSource="{Binding List.Rows}"
                          SelectedItem="{Binding List.SelectedRow, Mode=TwoWay}"
                          SelectionMode="Extended"
                          common:ListBehaviors.SelectedItems="{Binding List.SelectedRows}"
                          Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource MasterListItem}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          common:ListBehaviors.SelectOnRightClick="True"
                          common:ListBehaviors.FocusSelection="True">
                    <ListView.InputBindings>
                        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCustomCommand}" />
                        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyEntryCommand}" />
                        <KeyBinding Key="L" Modifiers="Control" Command="{Binding CopyClientLuaCommand}" />
                        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding AutocompleteSelectedCommand}" />
                        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding CopyToIdCommand}" />
                        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding RestoreToDefaultCommand}" />
                        <KeyBinding Key="E" Modifiers="Control" Command="{Binding SelectInItemsCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
                        <KeyBinding Key="F2" Command="{Binding ChangeIdCommand}" />
                    </ListView.InputBindings>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_AutoFromServer}" InputGestureText="Ctrl+Shift+A"
                                      Command="{Binding PlacementTarget.DataContext.AutocompleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource ClientItems_Ctx_AutoFromServerTip}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Sparkle24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_AddCustom}" InputGestureText="Ctrl+N"
                                      Command="{Binding PlacementTarget.DataContext.AddCustomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Add24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_Duplicate}" InputGestureText="Ctrl+D"
                                      Command="{Binding PlacementTarget.DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_CopyYaml}" InputGestureText="Ctrl+C"
                                      Command="{Binding PlacementTarget.DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource ClientItems_Ctx_CopyYamlTip}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="ClipboardLink24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_CopyLua}" InputGestureText="Ctrl+L"
                                      Command="{Binding PlacementTarget.DataContext.CopyClientLuaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource ClientItems_Ctx_CopyLuaTip}" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_ChangeId}" InputGestureText="F2"
                                      Command="{Binding PlacementTarget.DataContext.ChangeIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_CopyToId}" InputGestureText="Ctrl+Shift+D"
                                      Command="{Binding PlacementTarget.DataContext.CopyToIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_Restore}" InputGestureText="Ctrl+Shift+R"
                                      Visibility="{Binding PlacementTarget.DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding PlacementTarget.DataContext.RestoreToDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_Delete}" InputGestureText="Del"
                                      Command="{Binding PlacementTarget.DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource ClientItems_Ctx_SelectInItems}" InputGestureText="Ctrl+E"
                                      Command="{Binding PlacementTarget.DataContext.SelectInItemsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource ClientItems_Ctx_SelectInItemsTip}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="5,1" HorizontalAlignment="Left"
                                                Background="{Binding Origin, Converter={StaticResource OriginBrush}}">
                                            <TextBlock Text="{Binding Origin, Converter={StaticResource OriginLabel}}"
                                                       FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="22" Height="22"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="IdColumn" Header="{DynamicResource ClientItems_Col_ID}" Width="60" DisplayMemberBinding="{Binding KeyText}" />
                            <GridViewColumn x:Name="NameColumn" Header="{DynamicResource ClientItems_Col_Name}" Width="166" DisplayMemberBinding="{Binding Name}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#22FFFFFF" />

            <!-- Detail -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="{DynamicResource ClientItems_SelectPH}" Opacity="0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                              Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding Editor}" TextElement.FontSize="12">

                        <!-- Header: target label + autocomplete / copy actions -->
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="{DynamicResource ClientItems_Autocomplete}" Appearance="Secondary" Padding="10,4"
                                           Command="{Binding AutocompleteCommand}"
                                           ToolTip="{DynamicResource ClientItems_AutocompleteTip}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="{DynamicResource ClientItems_CopyLua}" Appearance="Transparent" Padding="10,4" Margin="6,0,0,0"
                                           Command="{Binding CopyLuaCommand}"
                                           ToolTip="{DynamicResource ClientItems_CopyLuaTip}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ClipboardLink24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                            <TextBlock Text="{Binding TargetLabel}" Opacity="0.7" FontSize="11.5" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Description toolbar (acts on the focused description box) -->
                        <ui:Card Padding="10,8" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="{DynamicResource ClientItems_Color}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button x:Name="NewLineButton" Content="{DynamicResource ClientItems_NewLine}" Focusable="False" Margin="8,0,0,0"
                                               ToolTip="{DynamicResource ClientItems_NewLineTip}" />
                                    <ui:Button x:Name="ResetColorButton" Content="{DynamicResource ClientItems_ResetColors}" Focusable="False" Margin="6,0,0,0"
                                               ToolTip="{DynamicResource ClientItems_ResetColorsTip}" />
                                </StackPanel>
                                <WrapPanel x:Name="SwatchPanel">
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#000000" Tag="000000" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#FFFFFF" Tag="FFFFFF" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#FF0000" Tag="FF0000" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#009900" Tag="009900" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#0000FF" Tag="0000FF" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#EFA300" Tag="EFA300" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#A335EE" Tag="A335EE" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#00AEEF" Tag="00AEEF" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                    <Border Width="20" Height="20" Margin="2" CornerRadius="3" BorderThickness="1" BorderBrush="#55000000" Background="#777777" Tag="777777" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" />
                                </WrapPanel>
                            </DockPanel>
                        </ui:Card>

                        <!-- Identified / Unidentified sections -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Copy between the two cards -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:Button Content="→" MinWidth="0" Padding="8,4" Margin="0,0,0,8" FontSize="15"
                                           Command="{Binding CopyToUnidentifiedCommand}"
                                           ToolTip="{DynamicResource ClientItems_CopyToUnidTip}" />
                                <ui:Button Content="←" MinWidth="0" Padding="8,4" FontSize="15"
                                           Command="{Binding CopyToIdentifiedCommand}"
                                           ToolTip="{DynamicResource ClientItems_CopyToIdTip}" />
                            </StackPanel>

                            <!-- Identified -->
                            <ui:Card Grid.Column="0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ClientItems_Identified}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource ClientItems_DisplayName}" Opacity="0.8" Margin="0,0,0,2" />
                                    <ui:TextBox Text="{Binding IdentifiedDisplayName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource ClientItems_ResourceName}" Opacity="0.8" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding IdentifiedResourceName, UpdateSourceTrigger=LostFocus}" />
                                        <ui:Button Grid.Column="1" Content="{DynamicResource ClientItems_Browse}" Command="{Binding BrowseIconCommand}"
                                                   Margin="6,0,0,0" ToolTip="{DynamicResource ClientItems_BrowseIconTip}" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource ClientItems_Description}" Opacity="0.8" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="IdDescBox" Text="{Binding IdentifiedDescription, UpdateSourceTrigger=LostFocus}"
                                                AcceptsReturn="True" MinHeight="120" MaxHeight="220" FontFamily="Consolas"
                                                VerticalScrollBarVisibility="Auto" TextChanged="IdDesc_TextChanged"
                                                GotKeyboardFocus="DescBox_GotFocus" />

                                    <TextBlock Text="{DynamicResource ClientItems_Preview}" Opacity="0.55" FontSize="11" Margin="0,10,0,3" />
                                    <Border Background="#EFEAD9" CornerRadius="4" Padding="8" MinHeight="70">
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding IconPreview}" Width="40" Height="40"
                                                   Margin="0,0,8,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding IdentifiedDisplayName}" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap" />
                                                <TextBlock x:Name="IdPreview" Foreground="Black" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>

                            <!-- Unidentified -->
                            <ui:Card Grid.Column="2" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ClientItems_Unidentified}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource ClientItems_DisplayName}" Opacity="0.8" Margin="0,0,0,2" />
                                    <ui:TextBox Text="{Binding UnidentifiedDisplayName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource ClientItems_ResourceName}" Opacity="0.8" Margin="0,0,0,2" />
                                    <ui:TextBox Text="{Binding UnidentifiedResourceName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource ClientItems_Description}" Opacity="0.8" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="UnidDescBox" Text="{Binding UnidentifiedDescription, UpdateSourceTrigger=LostFocus}"
                                                AcceptsReturn="True" MinHeight="120" MaxHeight="220" FontFamily="Consolas"
                                                VerticalScrollBarVisibility="Auto" TextChanged="UnidDesc_TextChanged"
                                                GotKeyboardFocus="DescBox_GotFocus" />

                                    <TextBlock Text="{DynamicResource ClientItems_Preview}" Opacity="0.55" FontSize="11" Margin="0,10,0,3" />
                                    <Border Background="#EFEAD9" CornerRadius="4" Padding="8" MinHeight="70">
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding IconPreview}" Width="40" Height="40"
                                                   Margin="0,0,8,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding UnidentifiedDisplayName}" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap" />
                                                <TextBlock x:Name="UnidPreview" Foreground="Black" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>
                        </Grid>

                        <!-- Common client fields -->
                        <ui:Card Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource ClientItems_Slots}" VerticalAlignment="Center" Opacity="0.85" Width="60" />
                                    <ui:TextBox Text="{Binding SlotCount, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,16,0" />
                                    <TextBlock Text="{DynamicResource ClientItems_ClassNum}" VerticalAlignment="Center" Opacity="0.85" Width="110" />
                                    <ui:TextBox Text="{Binding ClassNum, UpdateSourceTrigger=LostFocus}" Width="70" Margin="0,0,16,0" />
                                    <ui:ToggleSwitch Content="{DynamicResource ClientItems_Costume}" IsChecked="{Binding Costume}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding CanLinkSprite, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource ClientItems_HeadgearSprite}" VerticalAlignment="Center" Opacity="0.85" Width="100" />
                                    <ui:TextBox Text="{Binding SpriteName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{DynamicResource ClientItems_SpritePH}" Width="180" Margin="0,0,8,0" />
                                    <ui:Button Content="{DynamicResource ClientItems_Browse}" Command="{Binding BrowseSpriteCommand}" Margin="0,0,8,0"
                                               ToolTip="{DynamicResource ClientItems_BrowseSpriteTip}" />
                                    <ui:Button Content="{DynamicResource ClientItems_LinkSprite}" Command="{Binding LinkSpriteCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SpriteLinkMessage}" Opacity="0.8" Foreground="#7FD0A0" TextWrapping="Wrap"
                                           Visibility="{Binding SpriteLinkMessage, Converter={StaticResource StringToVis}}" Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
