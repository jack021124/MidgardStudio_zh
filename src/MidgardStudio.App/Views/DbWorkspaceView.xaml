<UserControl x:Class="MidgardStudio.App.Views.DbWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MidgardStudio.App.ViewModels"
             xmlns:common="clr-namespace:MidgardStudio.App.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DbWorkspaceViewModel}">

    <UserControl.Resources>
        <!-- Origin badge cell (Base / Override / Custom) — shared by the master list columns. -->
        <DataTemplate x:Key="OriginBadgeCellTemplate">
            <Border CornerRadius="3" Padding="5,1" HorizontalAlignment="Left"
                    Background="{Binding Origin, Converter={StaticResource OriginBrush}}">
                <TextBlock Text="{Binding Origin, Converter={StaticResource OriginLabel}}"
                           FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="IconCellTemplate">
            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
            <TextBlock Text="{DynamicResource Db_Loading}" Opacity="0.7" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Main content -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Master list -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                        <ui:Button Command="{Binding AddCustomCommand}" Margin="0,0,4,0" ToolTip="{DynamicResource Db_AddTip}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding DuplicateCommand}" Margin="0,0,4,0" ToolTip="{DynamicResource Db_DupTip}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding CopyEntryCommand}" Margin="0,0,4,0" ToolTip="{DynamicResource Db_CopyTip}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ClipboardLink24" /></ui:Button.Icon>
                        </ui:Button>
                        <ToggleButton IsChecked="{Binding List.OverriddenOnly, Mode=TwoWay}"
                                      ToolTip="{DynamicResource Db_FilterTip}">
                            <ui:SymbolIcon Symbol="Filter24" />
                        </ToggleButton>
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Tag="ListSearch" PlaceholderText="{DynamicResource Db_SearchPH}"
                                Text="{Binding List.SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding List.StatusText}" Opacity="0.6"
                           Margin="2,6,0,0" FontSize="11" />

                <ListView x:Name="MasterList" ItemsSource="{Binding List.Rows}"
                          SelectedItem="{Binding List.SelectedRow, Mode=TwoWay}"
                          SelectionMode="Extended"
                          common:ListBehaviors.SelectedItems="{Binding List.SelectedRows}"
                          common:ListBehaviors.FocusSelection="True"
                          Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource MasterListItem}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          common:ListBehaviors.SelectOnRightClick="True">
                    <ListView.InputBindings>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyEntryCommand}" />
                        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding CopyToIdCommand}" />
                        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding RestoreToDefaultCommand}" />
                        <KeyBinding Key="E" Modifiers="Control" Command="{Binding SelectInClientCommand}" />
                        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding AddInClientItemsCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
                        <KeyBinding Key="F2" Command="{Binding ChangeIdCommand}" />
                    </ListView.InputBindings>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Db_Ctx_Duplicate}" InputGestureText="Ctrl+D"
                                      Command="{Binding PlacementTarget.DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource Db_DupTip}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Db_Ctx_CopyYaml}" InputGestureText="Ctrl+C"
                                      Command="{Binding PlacementTarget.DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource Db_CopyTip}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="ClipboardLink24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource Db_Ctx_ChangeId}" InputGestureText="F2"
                                      Command="{Binding PlacementTarget.DataContext.ChangeIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource Db_Ctx_CopyToId}" InputGestureText="Ctrl+Shift+D"
                                      Command="{Binding PlacementTarget.DataContext.CopyToIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource Db_Ctx_Restore}" InputGestureText="Ctrl+Shift+R"
                                      Visibility="{Binding PlacementTarget.DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding PlacementTarget.DataContext.RestoreToDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      ToolTip="{DynamicResource Db_Ctx_RestoreTip}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowUndo24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Db_Ctx_Delete}" InputGestureText="Del"
                                      Command="{Binding PlacementTarget.DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator Visibility="{Binding PlacementTarget.DataContext.IsItemDb, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{DynamicResource Db_Ctx_SelectInClientItems}" InputGestureText="Ctrl+E"
                                      Visibility="{Binding PlacementTarget.DataContext.IsItemDb, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding PlacementTarget.DataContext.SelectInClientItemsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{DynamicResource Db_Ctx_AddInClientItems}" InputGestureText="Ctrl+Shift+E"
                                      Visibility="{Binding PlacementTarget.DataContext.IsItemDb, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding PlacementTarget.DataContext.AddInClientItemsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator Visibility="{Binding PlacementTarget.DataContext.IsSkillDb, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{DynamicResource Db_Ctx_SelectInClientSkills}" InputGestureText="Ctrl+E"
                                      Visibility="{Binding PlacementTarget.DataContext.IsSkillDb, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding PlacementTarget.DataContext.SelectInClientSkillsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <!-- Columns are built per-schema in code-behind (BuildColumns). -->
                        <GridView x:Name="MasterGrid" />
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#22FFFFFF" />

            <!-- Detail editor -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="{DynamicResource Db_SelectEntry}" Opacity="0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Editor.HasRecord, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <DockPanel Visibility="{Binding Editor.HasRecord, Converter={StaticResource BoolToVis}}">
                    <!-- Record identity header removed: the list already shows the selected entry + its origin. -->

                    <ui:InfoBar DockPanel.Dock="Top" Severity="Informational" IsClosable="True" Margin="0,0,0,8"
                                Title="{DynamicResource Db_Info}" Message="{Binding PortReportText}"
                                IsOpen="{Binding PortReportText, Converter={StaticResource StringToBool}}" />

                    <!-- Live validation issues for the selected record that aren't pinned to a visible field. -->
                    <ui:InfoBar DockPanel.Dock="Top" Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                                Title="{DynamicResource Db_Validation}" Message="{Binding Editor.RecordIssuesText}"
                                IsOpen="{Binding Editor.HasRecordIssues}" />

                    <!-- Client sprite registration (mobs only). Folded by default so it doesn't push the
                         drop table out of view; the user can expand it when they need to register a sprite. -->
                    <ui:CardExpander DockPanel.Dock="Bottom" Header="{DynamicResource Db_ClientSprite}" IsExpanded="False"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding SideEditor, Converter={StaticResource NotNullToVis}}">
                        <ContentControl Content="{Binding SideEditor}" />
                    </ui:CardExpander>

                    <!-- Two field cards (groups balanced across them); drop table sits below -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Editor.LeftColumn}" VerticalAlignment="Top" />
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Editor.RightColumn}" VerticalAlignment="Top" />
                            </Grid>
                            <ContentControl Content="{Binding AuxEditor}" Margin="0,10,0,0"
                                            Visibility="{Binding AuxEditor, Converter={StaticResource NotNullToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
