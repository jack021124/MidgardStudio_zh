<UserControl x:Class="MidgardStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MidgardStudio.App.ViewModels"
             xmlns:common="clr-namespace:MidgardStudio.App.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <!-- Left nav entry: rounded, highlights on hover + selection -->
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#D8D8E4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E8D2DF2" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One color row: name + live swatch + hex box (shared by semantic & element colors) -->
        <DataTemplate x:Key="AcColorRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Opacity="0.85" />
                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4" Margin="0,0,8,0"
                        BorderBrush="#55FFFFFF" BorderThickness="1" Background="{Binding Swatch}" />
                <ui:TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" Width="110" FontFamily="Consolas"
                            PlaceholderText="{DynamicResource Settings_Ac_HexPH}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left-side menu ===== -->
        <DockPanel Grid.Column="0" Margin="0,0,18,0">
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Settings_Title}" Style="{StaticResource TitleScreen}" Margin="0,0,0,16" />
            <ListBox x:Name="SettingsNav" SelectedIndex="0" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource SettingsNavItem}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Options24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings_Nav_General}" VerticalAlignment="Center" FontSize="13.5" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings_Nav_Shortcuts}" VerticalAlignment="Center" FontSize="13.5" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings_Nav_Autocomplete}" VerticalAlignment="Center" FontSize="13.5" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings_Nav_About}" VerticalAlignment="Center" FontSize="13.5" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ===== Right-side content (switched by the nav selection) ===== -->
        <Grid Grid.Column="1">

            <!-- General -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,8,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNav}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <ui:Card Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Language_Title}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="{DynamicResource Settings_Language_Desc}" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                      MinWidth="240" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Encoding_Title}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="{DynamicResource Settings_Encoding_Desc}" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Settings_Encoding_Go}" Padding="8,4" Margin="6,0,0,0"
                                           Command="{Binding ApplyCustomEncodingCommand}"
                                           Visibility="{Binding CustomEncodingVisible, Converter={StaticResource BoolToVis}}" />
                                <TextBox DockPanel.Dock="Right" Text="{Binding CustomEncodingText, UpdateSourceTrigger=PropertyChanged}" Width="64"
                                         VerticalContentAlignment="Center" ToolTip="{DynamicResource Settings_Encoding_CodepageTip}"
                                         Visibility="{Binding CustomEncodingVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplyCustomEncodingCommand}" /></TextBox.InputBindings>
                                </TextBox>
                                <ComboBox ItemsSource="{Binding EncodingChoices}"
                                          DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedGlobalEncoding, Mode=TwoWay}"
                                          MinWidth="240" HorizontalAlignment="Left" />
                            </DockPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_SaveBehaviour}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="{DynamicResource Settings_SaveBehaviour_Desc}" />

                            <RadioButton GroupName="Save" IsChecked="{Binding IsManual}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Save_Manual}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_Save_Manual_Desc}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Save" IsChecked="{Binding IsInterval}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Save_Interval}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{DynamicResource Settings_Save_Interval_Label}" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,0" />
                                        <ui:TextBox Width="80" Text="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsInterval}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Save_Interval_Desc}" Opacity="0.6" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Save" IsChecked="{Binding IsOnEdit}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Save_OnEdit}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_Save_OnEdit_Desc}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Backups}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Settings_Backups_Keep}" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,0" />
                                <ui:TextBox Width="72" Text="{Binding BackupRetention, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{DynamicResource Settings_Backups_PerProfile}" VerticalAlignment="Center" Opacity="0.75" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Backups_Desc}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Gate}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="{DynamicResource Settings_Gate_Desc}" />

                            <CheckBox Content="{DynamicResource Settings_Gate_CheckBefore}" IsChecked="{Binding ValidateBeforeSave}" Margin="0,0,0,6" />

                            <RadioButton GroupName="Gate" IsChecked="{Binding IsGateSoft}" IsEnabled="{Binding ValidateBeforeSave}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Gate_Soft}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_Gate_Soft_Desc}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Gate" IsChecked="{Binding IsGateHard}" IsEnabled="{Binding ValidateBeforeSave}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Gate_Hard}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_Gate_Hard_Desc}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Gate" IsChecked="{Binding IsGateAdvisory}" IsEnabled="{Binding ValidateBeforeSave}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Gate_Advisory}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_Gate_Advisory_Desc}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Shortcuts -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,8,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNav}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <ui:Card Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Shortcuts}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="{DynamicResource Settings_Shortcuts_Desc}" />
                            <ItemsControl ItemsSource="{Binding Shortcuts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Opacity="0.9" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding Gesture, Mode=TwoWay}"
                                                        common:ShortcutCapture.Enabled="True"
                                                        PlaceholderText="{DynamicResource Settings_Shortcuts_Placeholder}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Autocomplete -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,8,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNav}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="{DynamicResource Settings_Ac_Desc}" />

                    <!-- Live preview -->
                    <ui:Card Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Ac_Preview}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="{DynamicResource Settings_Ac_Preview_Desc}" Opacity="0.6" FontSize="12" Margin="0,0,0,8" />
                            <Border Background="#EFEAD9" CornerRadius="4" Padding="10" MinHeight="80">
                                <TextBlock x:Name="PreviewBox" TextWrapping="Wrap" FontSize="12" Foreground="Black" FontFamily="Segoe UI" />
                            </Border>
                        </StackPanel>
                    </ui:Card>

                    <!-- What to include -->
                    <ui:Card Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Ac_Include}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AutocompleteToggles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:ToggleSwitch Content="{Binding Display}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                         Width="330" Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <!-- Behaviour -->
                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Ac_Behaviour}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ui:ToggleSwitch Content="{DynamicResource Settings_Ac_Overwrite}"
                                             IsChecked="{Binding OverwriteExisting, Mode=TwoWay}" Margin="0,2,0,10" />
                            <TextBlock Text="{DynamicResource Settings_Ac_DefaultUnid}" Opacity="0.8" Margin="0,0,0,3" />
                            <ui:TextBox Text="{Binding DefaultUnidentifiedDescription, UpdateSourceTrigger=LostFocus}"
                                        AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="{DynamicResource Settings_Ac_DefaultUnid_PH}" />
                            <TextBlock Text="{DynamicResource Settings_Ac_Fallback}" Opacity="0.8" Margin="0,10,0,3" />
                            <ui:TextBox Text="{Binding MissingValueText, UpdateSourceTrigger=LostFocus}" Width="220" HorizontalAlignment="Left"
                                        PlaceholderText="{DynamicResource Settings_Ac_Fallback_PH}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Colors -->
                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Ac_Colors}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Settings_Ac_Colors_Desc}" Opacity="0.6" FontSize="12" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding SemanticColors}" ItemTemplate="{StaticResource AcColorRow}" />
                            <Border Height="1" Background="#1FFFFFFF" Margin="0,12" />
                            <TextBlock Text="{DynamicResource Settings_Ac_WeaponColors}" Opacity="0.85" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ElementColors}" ItemTemplate="{StaticResource AcColorRow}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Field labels -->
                    <ui:Card Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Ac_FieldLabels}" Style="{StaticResource SectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Settings_Ac_FieldLabels_Desc}" Opacity="0.6" FontSize="12" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding FieldLabels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DefaultLabel}" VerticalAlignment="Center" Opacity="0.85" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding Override, UpdateSourceTrigger=LostFocus}"
                                                        PlaceholderText="{Binding DefaultLabel}" Width="240" HorizontalAlignment="Left" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,8,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsNav}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <ui:Card Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource App_Title}" Style="{StaticResource TitleSection}" Margin="0,0,0,6" />
                            <TextBlock Opacity="0.75" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings_About_Card_Desc}" />
                            <Border Height="1" Background="#1FFFFFFF" Margin="0,14,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_About_Author}" Opacity="0.6" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Kyoshio" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_About_Edition}" Opacity="0.6" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Settings_About_EditionValue}" Margin="0,2" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
